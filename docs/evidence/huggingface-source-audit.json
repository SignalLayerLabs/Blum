  "findings": [
    {
      "code_path": "backend/app/services/trading_ml/forex_history.py",
      "consequence": "CSV order becomes invented market chronology; synthetic consolidated bars can produce invalid labels and inflated evidence.",
      "id": "P1-FOREX-CONFLICTS",
      "line": 179,
      "priority": 1,
      "remedy": "Quarantine all 632 rows from conflicting groups and the additional 223 unambiguous weekend rows; use only 71 attributable weekday snapshots with explicit replay-only limits.",
      "risk": "Domain Model Distortion",
      "source": "Evans \u2014 Domain-Driven Design, bounded context / domain model fidelity",
      "symptom": "926 source rows contain 178 exact full-row duplicate excess and collapse to 269 pair/date keys, including 146 conflicting-OHLC groups. _bars constructs first-open/max-high/min-low/last-close from same-day rows without intraday timestamps."
    },
    {
      "code_path": "backend/app/analyst/hf_training.py",
      "consequence": "Manifest falsely certifies information availability and a retrospective outcome dataset can be mistaken for leakage-free forecasting evidence.",
      "id": "P1-SNAPSHOT-AVAILABILITY",
      "line": 227,
      "priority": 1,
      "remedy": "Use outcome available_at to derive the true snapshot cutoff; freeze at a verified time, purge/embargo boundaries, preserve outcomes only in explicitly later reflection turns, and revalidate independent holdout distributions.",
      "risk": "Domain Model Distortion",
      "source": "Brooks \u2014 The Mythical Man-Month, conceptual integrity",
      "symptom": "Snapshot as_of derives solely from example.created_at; 29 outcome events occur after its cutoff and 170 outcomes cross next-split decision starts. temporal_leakage:false is assigned without proving label availability."
    },
    {
      "code_path": "backend/app/services/bootstrap.py",
      "consequence": "Invalid range bars can enter historical storage, affect indicators, stops and replay.",
      "id": "P1-PRICE-IMPORT",
      "line": 172,
      "priority": 1,
      "remedy": "Reject nonfinite/nonpositive OHLC and inconsistent OHLC geometry before ingestion, keep an immutable reject ledger; preserve eight null-volume flags for price-only replay.",
      "risk": "Domain Model Distortion",
      "source": "McConnell \u2014 Code Complete, defensive programming / data validation",
      "symptom": "price_row_from_cache accepts finite-or-nonfinite float close and parses other fields without OHLC geometry checks; five bundled bars have open > high."
    },
    {
      "code_path": "scripts/audit_blum_release_dataset.py",
      "consequence": "A structural/privacy pass can be mistaken for semantic safety, dataset integrity or model promotion approval.",
      "id": "P1-AUDIT-SCOPE",
      "line": 44,
      "priority": 1,
      "remedy": "Report separate integrity, privacy, point-in-time grounding, maturity and promotion verdicts; raw rows remain quarantined, and the reproducible sanitized derivative is eligible only for reasoning research pending licensing and independent evaluation.",
      "risk": "Domain Model Distortion",
      "source": "Brooks \u2014 The Mythical Man-Month, conceptual integrity",
      "symptom": "Official audit returns passed for all 521 raw examples even though every target contains unavailable price levels/scores and all market outcomes are inconclusive. It also does not compare dataset_sha256, per-row content hashes, split-specific counts or date bounds."
    }
  ],
